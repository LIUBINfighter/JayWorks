{
	"name": "jayworks-template",
	"version": "0.3.0",
	"description": "This is the JayWorks Template for Obsidian Plugin (https://obsidian.md)",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "npm run style && node esbuild.config.mjs",
		"build": "npm run style && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"style": "npm run lint && npm run format && node ./scripts/merge-styles.js --dir src/styles",
		"mix": "node ./scripts/mix-code.js --dir ../src",
		"clean": "node ./scripts/clean.js",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint --ext .ts,.js,.tsx,.mdx,.md src --max-warnings=0",
		"lint:fix": "eslint --ext .ts,.js,.tsx,.mdx,.md src --fix",
		"format": "prettier --write \"src/**/*.{ts,tsx,js,md,mdx,css}\""
	},
	"keywords": [],
	"author": "Jay Bridge",
	"license": "MPL-2.0",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "^8.46.4",
		"@typescript-eslint/parser": "^8.46.4",
		"builtin-modules": "3.3.0",
		"esbuild": "0.25.12",
		"eslint": "^8.0.0",
		"eslint-config-prettier": "^8.0.0",
		"eslint-plugin-mdx": "^2.3.4",
		"eslint-plugin-obsidianmd": "^0.1.8",
		"obsidian": "latest",
		"prettier": "^2.8.0",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"gray-matter": "^4.0.3",
		"highlight.js": "^11.10.0",
		"highlightjs-line-numbers.js": "^2.8.0",
		"lucide-react": "^0.553.0",
		"mark.js": "^8.11.1",
		"mermaid": "^10.9.1",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"rehype-react": "^8.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.0",
		"unified": "^11.0.4"
	}
}
